// Verification-only extension. The real entrypoint and public Pi APIs are unchanged.
import usageExtension from './index.ts';
import { appendFileSync } from 'node:fs';
import type { ExtensionAPI } from '@earendil-works/pi-coding-agent';

const record = (event: object) => appendFileSync(process.env.COMPAT_EVENTS!, JSON.stringify(event) + '\n');
export default function (pi: ExtensionAPI) {
  pi.on('session_start', () => {
    const mockFetch = (globalThis as any)[Symbol.for('cliproxy-compat.synthetic-fetch')];
    if (typeof mockFetch !== 'function') throw new Error('Synthetic fetch was not installed');
    globalThis.fetch = mockFetch;
    record({ kind: 'mock-restored' });
  });
  usageExtension(pi);
  pi.on('session_start', (_event, ctx) => {
    record({ kind: 'session-start', mode: ctx.mode, hasUI: ctx.hasUI, model: ctx.model?.id });
  });
  pi.on('session_shutdown', () => record({ kind: 'shutdown' }));
  pi.registerCommand('compat-model', {
    description: 'Compatibility smoke: switch between synthetic model routes',
    handler: async (args, ctx) => {
      const id = args.trim() === 'unsupported' ? 'o3' : 'gpt-4o';
      const model = ctx.modelRegistry.find('openai', id);
      if (!model || !(await pi.setModel(model))) throw new Error('Smoke model switch failed');
      record({ kind: 'model', id: ctx.model?.id });
      ctx.ui.notify(`SMOKE_MODEL ${ctx.model?.id}`, 'info');
    },
  });
  pi.registerCommand('compat-exit', {
    description: 'Compatibility smoke: orderly session shutdown',
    handler: async (_args, ctx) => ctx.shutdown(),
  });
}
